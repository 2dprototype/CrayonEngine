# Build outputs (root and build directories)
/build/
build/
*.exe
*.dll
*.dylib
*.so
*.o
*.obj
*.pdb
*.ilk
*.exp
*.apk
*.aab
.ninja_deps
.ninja_log

# Keep essential vendor and SDK prebuilt binaries
!/vendor/luajit/bin/*.dll
!/vendor/sdl3/bin/*.dll
!/sdk/bin/*.dll

# CMake in-source build artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Local / temporary
/ignore
blueprint.md
/models
imgui.ini
*.txt
!CMakeLists.txt
*.zip
license.dat

# Vendor dependencies: ignore temporary source repos, keep core libraries & prebuilts
/vendor/luajit-src/
/vendor/sdl3-src/

# Android & Gradle
.gradle/
**/build/
**/.cxx/
**/local.properties
/android/.gradle/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties

# IDE & Editor & OS files
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Plugin build output
/plugins/bin/
